{
  "name": "flip7",
  "version": "0.0.0",
  "description": "A multiplayer push-your-luck card game",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest",
    "typecheck": "cf workers types && tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "deploy": "vite build && cf deploy --prebuilt",
