    "cf": "1.0.0-rc.6",
    "eslint-plugin-solid": "^0.20.1",
    "filesystem-routing": "0.5.0",
    "fontless": "^1.4.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.3",
