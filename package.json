    "@solid-primitives/timer": "^1.4.5",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.1",
    "@solidjs/web": "^2.0.4",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/solid": "0.1.0-beta.17",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "solid-js": "^2.0.4",
    "valibot": "^1.5.0"
